      "vineta": "m11_me_pongo_roja"
     }
    ],
    "next": "n9"
   },
   "n9": {
    "speaker": "Majo",
    "text": "¡Bueno! ¿Esta noche salsoteca o qué? Hay una en San Fernando que es una chimba. Nada de excusas, chileno.",
