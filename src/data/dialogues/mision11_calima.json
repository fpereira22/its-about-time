 "m11_farma_sira": {
  "start": "n0",
  "nodes": {
   "n0": {
    "text": "La Farmadía otra vez. El mismo congelador. La misma cajera viendo la misma novela.",
    "effects": [
     {
      "vineta": "m11_farma_sira"
     }
    ],
    "next": "n1"
   },
   "n1": {
    "speaker": "Sira",
    "text": "¿Maracuyá no hay? ...Bueno, mora. ¿Tú?",
    "effects": [
     {
      "vineta": "m11_sira_mora"
     }
    ],
    "choices": [
     {
      "label": "«Choco-Doble.»",
