  "cafe_central": {
    "start": "inicio",
    "nodes": {
      "inicio": {
        "branches": [
          {
            "if": {
              "hasItem": "cafe"
            },
            "goto": "ya"
          },
          {
            "if": {
              "flag": "tomo_cafe"
            },
            "goto": "ya"
          },
          {
            "goto": "oferta"
          }
        ]
      },
      "oferta": {
        "speaker": "Señora del café",
        "text": "¡Cafecito, cafecito pa' despertar! A $700.",
        "choices": [
          {
            "label": "Uno, por favor ($700)",
            "if": {
              "minMoney": 700
            },
            "effects": [
              {
                "pay": 700
              },
              {
                "giveItem": "cafe"
              }
            ],
            "goto": "gracias"
          },
          {
            "label": "No me alcanza...",
            "if": {
              "not": {
                "minMoney": 700
              }
            },
            "goto": "fiado"
          },
          {
            "label": "No, gracias"
          }
        ]
      },
      "gracias": {
        "speaker": "Señora del café",
        "text": "Cuidado que quema. ¡Que le vaya bien!"
      },
      "fiado": {
        "speaker": "Señora del café",
        "text": "Ay, mijo. Fiado no doy, pero le deseo suerte igual."
      },
      "ya": {
        "speaker": "Señora del café",
        "text": "¿Otro? No, no, que después anda temblando en la prueba."
      }
    }
  },
