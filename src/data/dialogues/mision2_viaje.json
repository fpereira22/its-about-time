{
  "paine_salida": {
    "start": "inicio",
    "nodes": {
      "inicio": {
        "text": [
          "Lunes, {hora}. Hace frío y huele a pasto mojado.",
          "El tren a Estación Central sale a las 7:30 en punto. ¡A la estación, al oriente!"
        ],
        "effects": [
          {
            "setFlag": "salio_casa"
          },
          {
            "objective": "Ve a la Estación Paine (al oriente) · tren 7:30"
          }
        ]
      }
    }
  },
  "vecina_paine": {
    "start": "inicio",
    "nodes": {
      "inicio": {
        "speaker": "Vecina",
        "text": "¡Buenos días, mijo! ¿Va a la universidad? Apúrese, que el tren de las 7:30 no espera a nadie."
      }
    }
  },
  "perro_paine": {
    "start": "inicio",
    "nodes": {
      "inicio": {
        "text": "El perro de la esquina te acompaña unos metros moviendo la cola. Después se aburre y vuelve a su esquina."
      }
    }
  },
  "cartel_paine": {
    "start": "inicio",
    "nodes": {
      "inicio": {
        "text": "ESTACIÓN PAINE · Trenes a Estación Central."
