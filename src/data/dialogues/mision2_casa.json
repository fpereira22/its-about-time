{
  "mision2_intro": {
    "start": "inicio",
    "nodes": {
      "inicio": {
        "text": [
          "Domingo, 21:00. Paine, Inés de Suárez 122.",
          "Terminaste de comer con tu mamá. Mañana a las 8:30 tienes la prueba de Optimización: la más importante del semestre."
        ],
        "next": "mama"
      },
      "mama": {
        "speaker": "Mamá",
        "text": [
          "Ya, hijo: hoy te toca lavar la loza. Lleva los platos al lavaplatos, ¿ya?",
          "Y después a la ducha y a acostarse temprano, que mañana tenís prueba y el tren sale a las 7:30."
        ],
        "effects": [
          {
            "objective": "Lleva los platos al lavaplatos (cocina)"
          }
        ],
        "next": "tip"
      },
      "tip": {
        "text": "Estás sentado a la mesa. Muévete para pararte. Los platos están justo enfrente: presiona E."
      }
    }
  },
